# Backend AppSewa - Background Service
# Standalone daemon untuk menjalankan scheduler & notifikasi otomatis

BOT_NAME=backend appsewa
DATABASE_URL=mysql+aiomysql://root:rootpassword@localhost:3306/rental_system
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TLS=true

# Telegram Bot (untuk kirim notifikasi)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
ENVIRONMENT=development
SCHEDULER_TIMEZONE=Asia/Kuala_Lumpur

# Service Config
SERVICE_LOG_LEVEL=INFO
SERVICE_PID_FILE=/var/run/backend-appsewa.pid